{
  "name": "firstlight-socal-handoff",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "prettier --check .",
    "build:css": "sass --no-source-map --style=expanded styles:assets && prettier --write 'assets/*.css'",
    "prepare:publish": "npm run build:css && python3 tools/prepare-publish.py && prettier --write publish/_worker.js",
    "preview": "npm run build:css && python3 tools/preview.py",
    "test": "c8 --include=assets/lib/**/*.js --reporter=text --reporter=text-summary --reporter=json-summary node --test tests/unit/*.test.js",
    "test:routes": "node tests/test_routes.mjs",
    "test:all": "npm test && npm run test:routes"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "c8": "^10.1.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.0",
    "sass": "^1.108.2"
  }
}
